# Leave empty during local development to use the Vite /api proxy.
# Production: set to the Render API origin, with no trailing slash.
VITE_API_BASE_URL=
VITE_DEMO_MODE=false
# Public demo credentials are deliberately visible to visitors when demo mode is enabled.
VITE_DEMO_AUTHORITY_EMAIL=
VITE_DEMO_AUTHORITY_PASSWORD=
VITE_DEMO_CITIZEN_EMAIL=
VITE_DEMO_CITIZEN_PASSWORD=
