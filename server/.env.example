PORT=5000
NODE_ENV=development
MONGO_URI=
# Required: use a randomly generated secret with at least 32 characters.
JWT_SECRET=
# Optional; if omitted, derived from JWT_SECRET using a separate key context.
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DEMO_MODE=false
# Required only when DEMO_MODE=true. These credentials are shown on the login screen.
DEMO_AUTHORITY_PASSWORD=
DEMO_CITIZEN_PASSWORD=
GEMINI_API_KEY=
# Stable multimodal model with image input; check Google AI Studio for current free-tier quotas.
GEMINI_MODEL=gemini-3.5-flash-lite
